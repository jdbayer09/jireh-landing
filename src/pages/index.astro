---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import cargandoImg from '../assets/cargando.png';
---

<Layout>
	<main>
		<div class="stage">
			<Image
				src={cargandoImg}
				alt="Jireh Exportaciones y Asesorias S.A.S — Sitio en construcción"
				format="webp"
				quality={85}
				class="dancing"
			/>
		</div>

		<div class="bottom-bar">
			<div class="progress-bar-wrapper">
				<div class="progress-bar"></div>
			</div>
		</div>
	</main>
</Layout>

<style>
	html, body {
		margin: 0;
		padding: 0;
		width: 100%;
		height: 100%;
	}

	main {
		min-height: 100vh;
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, #0a1628 0%, #1a3a5c 55%, #0d2240 100%);
		position: relative;
		overflow: hidden;
	}

	/* Subtle radial glow behind the image */
	main::before {
		content: '';
		position: absolute;
		width: 70vw;
		height: 70vh;
		background: radial-gradient(ellipse at center, rgba(201,168,76,0.07) 0%, transparent 70%);
		pointer-events: none;
	}

	.stage {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		flex: 1;
		padding: 2rem;
		box-sizing: border-box;
	}

	.dancing {
		max-width: min(90vw, 860px);
		max-height: 75vh;
		width: auto;
		height: auto;
		animation: dance 1.6s ease-in-out infinite;
		transform-origin: center bottom;
		filter: drop-shadow(0 16px 40px rgba(0, 0, 0, 0.5));
	}

	/* Dance: bob + wiggle + micro-scale pulse */
	@keyframes dance {
		0%   { transform: translateY(0px)   rotate(0deg)   scale(1);    }
		15%  { transform: translateY(-14px) rotate(-3deg)  scale(1.02); }
		30%  { transform: translateY(-6px)  rotate(2.5deg) scale(1);    }
		45%  { transform: translateY(-18px) rotate(-2deg)  scale(1.03); }
		60%  { transform: translateY(-4px)  rotate(3deg)   scale(1);    }
		75%  { transform: translateY(-12px) rotate(-2.5deg)scale(1.02); }
		100% { transform: translateY(0px)   rotate(0deg)   scale(1);    }
	}

	/* Progress bar */
	.bottom-bar {
		width: 100%;
		padding: 0 0 2.5rem;
		display: flex;
		justify-content: center;
	}

	.progress-bar-wrapper {
		width: clamp(200px, 40vw, 480px);
		height: 5px;
		background: rgba(255, 255, 255, 0.15);
		border-radius: 99px;
		overflow: hidden;
	}

	.progress-bar {
		height: 100%;
		background: linear-gradient(90deg, #c9a84c, #f0d080, #c9a84c);
		background-size: 200% auto;
		border-radius: 99px;
		animation: progress 3s ease-in-out infinite alternate, shimmer 2s linear infinite;
	}

	@keyframes shimmer {
		0%   { background-position: 200% center; }
		100% { background-position: -200% center; }
	}

	@keyframes progress {
		0%   { width: 20%; }
		100% { width: 75%; }
	}
</style>
