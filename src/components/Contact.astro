            />
          </div>

          <div>
            <label for="mensaje" class="block text-sm font-medium text-gray-700 mb-2">Mensaje</label>
            <textarea
              id="mensaje"
              name="mensaje"
              rows="4"
              class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-green-500 focus:ring-2 focus:ring-green-200 transition-all outline-none resize-none"
              placeholder="¿En qué podemos ayudarle?"
