---
const backgroundImage = "/hero-bg.jpg";
---

<section id="inicio" class="relative min-h-screen flex items-center justify-center bg-gradient-to-br from-green-50 to-green-100 pt-20">
  <div class="absolute inset-0 bg-[url('/hero-pattern.svg')] opacity-5"></div>

  <div class="container mx-auto px-4 py-20 relative z-10">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Badge -->
      <div class="inline-block bg-green-600/10 text-green-700 px-4 py-2 rounded-full text-sm font-semibold mb-6">
        Exportamos lo mejor de Colombia
      </div>

      <!-- Title -->
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-gray-900 mb-6 leading-tight">
        JIREH Exportaciones y Asesorías S.A.S
      </h1>

      <!-- Subtitle -->
      <p class="text-lg md:text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
        Conectamos la riqueza agrícola colombiana con el mundo. Especialistas en exportación de aguacate y productos de la tierra.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="#servicios"
          class="bg-green-600 hover:bg-green-700 text-white px-8 py-4 rounded-full font-semibold text-lg transition-all hover:shadow-xl hover:scale-105"
        >
          Conoce nuestros servicios
        </a>
        <a
          href="#nosotros"
          class="bg-white hover:bg-gray-50 text-green-700 border-2 border-green-600 px-8 py-4 rounded-full font-semibold text-lg transition-all hover:shadow-lg"
        >
          Saber más
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </div>
</section>
